{
  "name": "expo-starter-kit",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "yarn expo run:android",
    "android:clean": "cd android && ./gradlew clean && cd .. && yarn expo run:android",
    "ios": "yarn expo run:ios",
    "build:android": "yarn expo build:android",
    "build:ios": "yarn expo build:ios",
    "eas:build:development": "eas build --profile development",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:production": "eas build --profile production",
    "env:copy:dev": "cp .env.dev .env",
    "env:copy:qa": "cp .env.preview .env",
    "env:copy:prod": "cp .env.prod .env",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "format:fix": "prettier --write .",
    "format": "prettier --check .",
    "test:unit": "env-cmd --file .env.test yarn jest",
    "test:watch": "env-cmd --file .env.test yarn jest --watch",
    "test:unit:update": " env-cmd --file .env.test jest --coverage -u --forceExit",
    "typecheck": "tsc --noemit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.3.14",
    "@react-navigation/native": "^7.1.10",
    "@react-navigation/stack": "^7.3.3",
    "@reduxjs/toolkit": "^2.8.2",
    "@sentry/react-native": "^6.14.0",
    "@types/react-native": "^0.73.0",
    "axios": "^1.9.0",
    "expo": "~53.0.6",
    "expo-status-bar": "~2.2.3",
    "lodash": "^4.17.21",
    "lucide-react-native": "^0.511.0",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "^2.25.0",
    "react-native-modalfy": "^3.6.0",
    "react-native-reanimated": "^3.18.0",
    "react-native-safe-area-context": "^5.4.1",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "^15.12.0",
    "react-native-svg-transformer": "^1.5.1",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-persist-transform-filter": "^0.0.22",
    "redux-thunk": "^3.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/lodash": "^4",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "~5.8.3"
  },
  "engines": {
    "npm": "Unsupported. Use Yarn instead.",
    "yarn": ">= 4.6.0",
    "node": ">= 20"
  },
  "private": true,
  "packageManager": "yarn@4.9.1"
}
